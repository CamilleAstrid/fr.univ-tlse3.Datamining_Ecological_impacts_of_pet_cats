# Sélectionner uniquement les colonnes numériques (hors animal.id et Hunt)
numeric_vars <- OutCatdata %>%
select(where(is.numeric)) %>%
select(-c(animal.id)) %>%  # on retire éventuellement l'ID s'il est numérique
names()
# Sélectionner uniquement les colonnes numériques (hors animal.id et Hunt)
numeric_vars <- OutCatdata %>%
select(where(is.numeric)) %>%
names()
# Pour chaque variable numérique, générer un boxplot par classe de Hunt
plot_list <- lapply(numeric_vars, function(var) {
p <- ggplot(OutCatdata, aes(x = Hunt, y = .data[[var]], fill = Hunt)) +
geom_boxplot() +
labs(title = paste("Boxplot de", var, "par classe de chasse"),
x = "Comportement de chasse",
y = var) +
theme_minimal()
ggplotly(p)
})
# Pour chaque variable numérique, générer un boxplot par classe de Hunt
plot_list <- lapply(numeric_vars, function(var) {
p <- ggplot(OutCatdata, aes(x = Hunt, y = .data[[var]], fill = Hunt)) +
geom_boxplot() +
labs(title = paste("Boxplot de", var, "par classe de chasse"),
x = "Comportement de chasse",
y = var) +
theme_minimal()
ggplotly(p)
})
# Afficher le premier plot (par exemple) ou utiliser subplot() pour tous les afficher
plot_list[[1]]  # Pour visualiser le premier
#V2
# Fonction pour créer un ggplotly boxplot par variable
make_boxplot <- function(var) {
ggplot(OutCatdata, aes(x = Hunt, y = .data[[var]], fill = Hunt)) +
geom_boxplot() +
labs(
title = glue::glue("Distribution de {var} selon le comportement de chasse"),
x = "Comportement de chasse (Hunt)",
y = var
) +
theme_minimal() %>%
ggplotly()
}
# Génération des plots dans une liste
boxplots <- map(numeric_vars, make_boxplot)
# Affiche le premier plot pour vérifier
boxplots[[1]]
# ou
subplot(plot_list, nrows = length(plot_list))  # pour tous les afficher dans une grille
